# ─────────────────────────────────────────────────────────────
# Brandmind – Frontend environment variables
# Copy to frontend/.env (local) or set in Netlify site settings.
# ─────────────────────────────────────────────────────────────

# Base URL of the deployed backend (no trailing slash, no /api).
# The app appends "/api" itself.
REACT_APP_BACKEND_URL=https://brandmind-api.onrender.com

# --- AI Business Card --------------------------------------------------------
# No extra key is required. QR images are generated client-side via the public
# qrserver.com image endpoint; replace in code if your deployment needs a
# private QR provider.
