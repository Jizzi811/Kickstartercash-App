# ─────────────────────────────────────────────────────────────
# Brandmind – Backend environment variables
# Copy to backend/.env (local) or set in your host (Render/Railway).
# ─────────────────────────────────────────────────────────────

# --- Database (required) -----------------------------------------------------
# MongoDB connection string (e.g. MongoDB Atlas free tier)
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=brandmind

# --- Auth (required in production) -------------------------------------------
# Long random secret used to sign login tokens. Generate one, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BRANDMIND_JWT_SECRET=change-me-to-a-long-random-string

# Public URL of the frontend (used for Stripe redirect URLs)
BRANDMIND_APP_URL=https://brandmind.example.com

# --- LLM providers (at least one required for generation) -------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional:
ANTHROPIC_API_KEY=
EMERGENT_LLM_KEY=

# --- Image generation (optional) --------------------------------------------
POYO_API_KEY=

# --- Email (optional – funnel leads / reports) ------------------------------
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev

# --- Billing / Stripe (optional – required only for paid plans) -------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# --- CORS (optional) ---------------------------------------------------------
# Comma-separated allowed origins; default "*"
CORS_ORIGINS=*
