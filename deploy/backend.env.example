# ─────────────────────────────────────────────────────────────
# Brandmind – Backend environment variables
# Copy to backend/.env (local) or set in your host (Render/Railway).
# ─────────────────────────────────────────────────────────────

# --- Database (required) -----------------------------------------------------
# MongoDB connection string (e.g. MongoDB Atlas free tier)
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=brandmind

# --- Auth (required in production) -------------------------------------------
# Long random secret used to sign login tokens. Generate one, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BRANDMIND_JWT_SECRET=change-me-to-a-long-random-string

# Public URL of the frontend (used for Stripe redirect URLs)
BRANDMIND_APP_URL=https://brandmind.example.com

# --- LLM providers (at least one required for generation) -------------------
OPENAI_API_KEY=
# Model the "GPT" button uses for text. Change here if gpt-5.2 is unavailable
# on your OpenAI account (e.g. OPENAI_TEXT_MODEL=gpt-4o).
# OPENAI_TEXT_MODEL=gpt-5.2
GEMINI_API_KEY=
# Optional:
ANTHROPIC_API_KEY=
EMERGENT_LLM_KEY=

# --- FreeTheAi (optional – free OpenAI-compatible gateway: text + image + TTS)
# Get a key via the FreeTheAi Discord (/signup) and run /checkin once per UTC day.
FREETHEAI_API_KEY=
# Optional overrides:
# FREETHEAI_BASE=https://api.freetheai.xyz/v1
# FREETHEAI_IMAGE_MODEL=eve/gpt-image-2
# FREETHEAI_TEXT_MODEL=opc/deepseek-v4-flash-free
# FREETHEAI_TTS_MODEL=xai/grok-tts

# --- NVIDIA NIM (optional – OpenAI-compatible: build.nvidia.com) ------------
# Get a key at https://build.nvidia.com (keys look like "nvapi-...").
# Usable both as the "nvidia" model choice and as a provider in the AI Gateway.
NVIDIA_API_KEY=
# Optional overrides:
# NVIDIA_BASE=https://integrate.api.nvidia.com/v1
# NVIDIA_TEXT_MODEL=meta/llama-3.1-70b-instruct

# --- Image generation (optional) --------------------------------------------
POYO_API_KEY=

# --- NVIDIA image models (optional – extra Design-Studio image models) ------
# Flux 2, Flux.1 schnell, Qwen Image and Stable Diffusion 3.5 run over the SAME
# NVIDIA_API_KEY as the text provider (see above). No extra key needed – set
# NVIDIA_API_KEY and these models light up in the Design Studio.
# Without NVIDIA_API_KEY only the default "GPT Image" option works.
# Optional overrides (defaults shown):
# NVIDIA_IMAGE_BASE=https://ai.api.nvidia.com/v1/genai
# NVIDIA_MODEL_FLUX2=black-forest-labs/flux.2-klein-4b
# NVIDIA_MODEL_FLUX_SCHNELL=black-forest-labs/flux.1-schnell
# NVIDIA_MODEL_QWEN=qwen/qwen-image
# NVIDIA_MODEL_SD3=stabilityai/stable-diffusion-3.5-large

# --- Email (optional – funnel leads / reports) ------------------------------
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev

# --- Billing / Stripe (optional – required only for paid plans) -------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# --- CORS (optional) ---------------------------------------------------------
# Comma-separated allowed origins; default "*"
CORS_ORIGINS=*
